# GEMINI_API_KEY: Required for Gemini AI API calls (story, vision, translation, Gemini images).
# Configure via .env locally, or Secrets in AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Base URL where the app is hosted (local or Cloud Run).
APP_URL=http://localhost:3000

# HUGGING_FACE_TOKEN: Required only when using the Hugging Face image engine.
HUGGING_FACE_TOKEN=your_huggingface_token_here
